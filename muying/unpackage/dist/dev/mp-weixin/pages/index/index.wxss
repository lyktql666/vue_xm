.page-container.data-v-1cf27b2a {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f4f4f4;
}
.header-section.data-v-1cf27b2a {
  background-color: #ff4d4f;
  z-index: 999;
}
.search-box.data-v-1cf27b2a {
  background: #fff;
  height: 32px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  padding: 0 4px 0 15px;
  margin: 10px 15px;
}
.search-icon.data-v-1cf27b2a {
  font-size: 16px;
  margin-right: 5px;
}
.search-input.data-v-1cf27b2a {
  flex: 1;
  font-size: 14px;
}
.search-btn.data-v-1cf27b2a {
  background: linear-gradient(to right, #ff9000, #ff4d4f);
  color: #fff;
  font-size: 13px;
  height: 26px;
  line-height: 26px;
  padding: 0 12px;
  border-radius: 13px;
}
.custom-tabs.data-v-1cf27b2a {
  display: flex;
  justify-content: space-around;
  padding: 5px 0 10px;
}
.tab-item.data-v-1cf27b2a {
  position: relative;
  color: rgba(255, 255, 255, 0.7);
  font-size: 15px;
  transition: all 0.3s;
}
.tab-item.active.data-v-1cf27b2a {
  color: #fff;
  font-size: 18px;
  font-weight: bold;
}
.tab-line.data-v-1cf27b2a {
  position: absolute;
  bottom: -6px;
  left: 50%;
  transform: translateX(-50%);
  width: 20px;
  height: 3px;
  background-color: #fff;
  border-radius: 2px;
}
.main-swiper.data-v-1cf27b2a {
  flex: 1;
}
.scroll-content.data-v-1cf27b2a {
  height: 100%;
}
.banner-box.data-v-1cf27b2a {
  padding: 10px 10px 0;
  background: linear-gradient(to bottom, #ff4d4f 0%, #f4f4f4 100%);
}
.swiper.data-v-1cf27b2a {
  height: 140px;
  border-radius: 10px;
  overflow: hidden;
}
.swiper-img.data-v-1cf27b2a {
  width: 100%;
  height: 100%;
}
.empty-banner.data-v-1cf27b2a {
  background-color: #e5e5e5;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
}
.king-kong-area.data-v-1cf27b2a {
  display: flex;
  padding: 15px 10px;
  background: #fff;
  margin: 10px;
  border-radius: 12px;
}
.grid-item.data-v-1cf27b2a {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.grid-icon.data-v-1cf27b2a {
  width: 48px;
  height: 48px;
  margin-bottom: 6px;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff1ed, #ffe1dc);
  display: flex;
  align-items: center;
  justify-content: center;
}
.grid-icon-text.data-v-1cf27b2a {
  font-size: 26px;
  line-height: 1;
}
.grid-text.data-v-1cf27b2a {
  font-size: 12px;
  color: #666;
}
.guess-you-like.data-v-1cf27b2a {
  text-align: center;
  padding: 15px 0 5px;
}
.title-text.data-v-1cf27b2a {
  font-size: 16px;
  font-weight: bold;
  color: #ff4d4f;
  letter-spacing: 2px;
}
.product-list.data-v-1cf27b2a {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 10px;
}
.product-card.data-v-1cf27b2a {
  width: 48.5%;
  background: #fff;
  border-radius: 10px;
  margin-bottom: 10px;
  overflow: hidden;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
}
.img-box.data-v-1cf27b2a {
  position: relative;
  width: 100%;
  height: 170px;
}
.pic.data-v-1cf27b2a {
  width: 100%;
  height: 100%;
  background-color: #f9f9f9;
}
.out-of-stock.data-v-1cf27b2a {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  font-weight: bold;
  letter-spacing: 2px;
}
.info-box.data-v-1cf27b2a {
  padding: 10px;
}
.name.data-v-1cf27b2a {
  font-size: 13px;
  color: #333;
  line-height: 1.4;
  height: 36px;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.tag.data-v-1cf27b2a {
  background: #ff4d4f;
  color: #fff;
  font-size: 10px;
  padding: 1px 4px;
  border-radius: 3px;
  margin-right: 4px;
}
.tags.data-v-1cf27b2a {
  margin: 6px 0;
  display: flex;
  gap: 4px;
}
.mini-tag.data-v-1cf27b2a {
  border: 1px solid #ff4d4f;
  color: #ff4d4f;
  font-size: 9px;
  padding: 0 3px;
  border-radius: 2px;
}
.price-row.data-v-1cf27b2a {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 5px;
}
.price.data-v-1cf27b2a {
  color: #ff4d4f;
  font-weight: bold;
}
.symbol.data-v-1cf27b2a {
  font-size: 12px;
  margin-right: 2px;
}
.big-num.data-v-1cf27b2a {
  font-size: 18px;
}
.sales.data-v-1cf27b2a {
  font-size: 11px;
  color: #999;
  margin-bottom: 2px;
}
.bottom-tips.data-v-1cf27b2a {
  text-align: center;
  color: #ccc;
  font-size: 12px;
  padding: 20px 0;
}

/* 占位页面样式 */
.empty-page.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}
.empty-text.data-v-1cf27b2a {
  color: #999;
  font-size: 14px;
  margin-top: 50%;
  display: block;
  text-align: center;
}