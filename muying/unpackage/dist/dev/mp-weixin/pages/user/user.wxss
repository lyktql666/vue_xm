.page-container.data-v-0f7520f0 { background-color: #f4f4f4; min-height: 100vh; position: relative; padding-bottom: 20px;}
.header-bg.data-v-0f7520f0 { position: absolute; top: 0; left: 0; right: 0; height: 200px; background: linear-gradient(to bottom, #ff4d4f, #ff7a7b); border-radius: 0 0 20% 20%; z-index: 0;
}
.box-card.data-v-0f7520f0 { background: #fff; margin: 0 15px 15px; border-radius: 12px; padding: 15px; position: relative; z-index: 10;
}
.user-card.data-v-0f7520f0 { display: flex; align-items: center; padding: 30px 20px 20px; position: relative; z-index: 10; margin-top: 40px;
}
.avatar.data-v-0f7520f0 { width: 60px; height: 60px; border-radius: 50%; border: 2px solid #fff; margin-right: 15px; background: #eee;
}
.info .name.data-v-0f7520f0 { font-size: 20px; font-weight: bold; color: #fff; margin-bottom: 5px;
}
.info .phone.data-v-0f7520f0 { font-size: 13px; color: rgba(255,255,255,0.8);
}
.section-title.data-v-0f7520f0 { font-size: 15px; font-weight: bold; color: #333; margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center;
}
.view-all.data-v-0f7520f0 { font-size: 12px; color: #999; font-weight: normal;
}

/* 宫格样式与红点定位 */
.order-grid.data-v-0f7520f0 { display: flex; justify-content: space-between;
}
.grid-item.data-v-0f7520f0 { display: flex; flex-direction: column; align-items: center; position: relative;
}
.icon-wrap.data-v-0f7520f0 { position: relative; display: inline-block; margin-bottom: 8px;}
.icon.data-v-0f7520f0 { font-size: 26px;
}
.badge.data-v-0f7520f0 { position: absolute; top: -4px; right: -8px; background: #ff4d4f; color: #fff; border: 1px solid #fff; font-size: 10px; min-width: 14px; height: 14px; line-height: 12px; text-align: center; border-radius: 7px; font-weight: bold; padding: 0 3px;}
.text.data-v-0f7520f0 { font-size: 12px; color: #666;
}
.list-item.data-v-0f7520f0 { display: flex; justify-content: space-between; padding: 15px 0; border-bottom: 1px solid #f9f9f9; font-size: 14px; color: #333;
}
.list-item.data-v-0f7520f0:last-child { border-bottom: none; padding-bottom: 0;
}
.right.data-v-0f7520f0 { color: #ccc;
}
.logout-btn.data-v-0f7520f0 { margin: 20px 15px; background: #fff; color: #333; text-align: center; height: 46px; line-height: 46px; border-radius: 23px; font-size: 15px;
}