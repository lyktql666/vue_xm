.num.data-v-c91e7611 { width: 36px; text-align: center; font-size: 13px; border-left: 1px solid #eee; border-right: 1px solid #eee; font-weight: bold; line-height: 26px;}
.invalid-tip.data-v-c91e7611 { color: #999; font-size: 12px; background: #f5f5f5; padding: 4px 8px; border-radius: 4px; display: inline-block; align-self: flex-start;}
.empty-cart.data-v-c91e7611 { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
